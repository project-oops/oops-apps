#!/usr/bin/env bash
# oops-apps - the dev CLI for the apps built on oops-sdk.
#
# The verbs every OOPS repository carries. An app is a directory under src/<category>/
# with a Makefile, and each verb reaches the app through that Makefile:
#
#   ./bin/oops-apps list              # the apps here
#   ./bin/oops-apps build [app...]    # build each (default: all)
#   ./bin/oops-apps make <app> [args] # build an app's targets (default: package/title)
#   ./bin/oops-apps restore <app>     # restore an app's title directory to hardware via pros
#   ./bin/oops-apps check [app...]    # formatting, then each app's own gate (default: all)
#   ./bin/oops-apps fmt [--check]     # clang-format first-party C and C++ in place
#   ./bin/oops-apps dist [app...]     # stage each app's shippable artifacts under <app>/dist/
#   ./bin/oops-apps clean [app...]    # remove build output
#
# Each app's `dist` target puts its release artifacts under `dist/` (an `.elf`, a `.zip`,
# a `.pkg`); this script and CI take whatever `dist/` holds and never learn a format. An
# app with no `dist` target ships nothing and is reported, not failed.
set -euo pipefail

cd "$(dirname "$0")/.."
HERE="$PWD"

# On Windows, if X:\toolchains is present, prepend toolchains to PATH
if [ -d "/x/toolchains" ] || [ -d "X:/toolchains" ] || [ -d "X:\\toolchains" ]; then
    tc_root=""
    [ -d "/x/toolchains" ] && tc_root="/x/toolchains"
    [ -z "$tc_root" ] && [ -d "X:/toolchains" ] && tc_root="X:/toolchains"
    if [ -n "$tc_root" ]; then
        [ -d "$tc_root/Python314" ] && export PATH="$tc_root/Python314:$PATH"
        [ -d "$tc_root/llvm21/bin" ] && export PATH="$tc_root/llvm21/bin:$PATH"
        [ -d "$tc_root/make/bin" ] && export PATH="$tc_root/make/bin:$PATH"
    fi
fi

# Build with the machine rather than one file at a time. `common/jobs.sh` works out how
# many compiles fit in the memory that is free and adds a load limit so a build running
# beside this one gets its share; `OOPS_JOBS` overrides it and `OOPS_JOBS=0` turns it off.
# It is computed once, and only the top-level make is given it - make's own jobserver hands
# the budget down to sub-makes, which is why this does not go in a makefile.
JOBS="$(sh "$HERE/common/jobs.sh")"
# shellcheck disable=SC2086  # deliberately word-split: it is two flags or none

# Normalize Windows backslashes and relative prefixes.
normalize_path() {
    local p="${1//\\//}"
    p="${p%/}"
    p="${p#./}"
    printf '%s' "$p"
}

# Every app under src/<category>/, one per line, as a bare name. The name carries no
# category, so CI artifact names and verbs do not change when an app moves category.
apps() {
    for d in src/*/*/; do
        [ -f "$HERE/${d}Makefile" ] && {
            name="${d%/}"
            printf '%s\n' "${name##*/}"
        }
    done
}

# Where an app of this name lives, or nothing. A name found in two categories is an error,
# because a bare name identifies an app only while it is unique.
app_path() {
    local want="$1" found="" d
    for d in "$HERE"/src/*/"$want"; do
        [ -f "$d/Makefile" ] || continue
        if [ -n "$found" ]; then
            echo "oops-apps: '$want' exists in more than one category ($found and $d)" >&2
            exit 2
        fi
        found="$d"
    done
    [ -n "$found" ] && printf '%s\n' "$found"
}

# Resolve an app argument to its directory under oops-apps (or an absolute path).
resolve_app_dir() {
    local raw="$1"
    local p
    p="$(normalize_path "$raw")"
    p="${p#oops-apps/}"

    if [ -f "$p/Makefile" ]; then
        (cd "$p" && pwd)
        return 0
    fi
    if [ -f "$HERE/$p/Makefile" ]; then
        (cd "$HERE/$p" && pwd)
        return 0
    fi
    if [ -f "$HERE/src/$p/Makefile" ]; then
        (cd "$HERE/src/$p" && pwd)
        return 0
    fi

    local base="${p##*/}"
    local found
    found="$(app_path "$base")"
    if [ -n "$found" ] && [ -f "$found/Makefile" ]; then
        (cd "$found" && pwd)
        return 0
    fi

    return 1
}

# The apps to act on: the ones named, or all of them. A name with no Makefile is an error.
resolve() {
    if [ "$#" -eq 0 ]; then
        apps
        return
    fi
    for name in "$@"; do
        if dir="$(resolve_app_dir "$name")"; then
            basename "$dir"
        else
            echo "oops-apps: no app '$name' (a directory with a Makefile under src/<category>/)" >&2
            exit 2
        fi
    done
}

# Prints why an app is skipped and returns 0, or returns 1 to build it. Skipped: `CI_SKIP=1`,
# or a Mesa title with no oops-mesa build to link (the release's oops-mesa job builds those).
ci_skip_reason() {
    local dir="$1"
    if grep -qE '^[[:space:]]*CI_SKIP[[:space:]]*=[[:space:]]*1' "$dir/app.env" 2>/dev/null; then
        printf 'held out of CI (CI_SKIP=1)'
        return 0
    fi
    if grep -qE 'OOPS_RENDERER[[:space:]]*[:?]?=[[:space:]]*mesa|USE_MESA[[:space:]]*[:?]?=[[:space:]]*1' \
             "$dir/Makefile" "$dir/app.env" 2>/dev/null && [ ! -e "$HERE/../oops-mesa/build/mesa" ]; then
        printf 'a Mesa title, and there is no oops-mesa build here'
        return 0
    fi
    return 1
}

# A developer payload (KIND=payload). Its build failure is reported but does not fail the run.
is_payload() {
    grep -qE '^[[:space:]]*KIND[[:space:]]*=[[:space:]]*payload' "$1/app.env" 2>/dev/null
}

over() {
    local target="$1"
    shift
    local any=0
    for app in $(resolve "$@"); do
        any=1
        app_dir="$(resolve_app_dir "$app")"
        if reason="$(ci_skip_reason "$app_dir")"; then
            printf '=== %s: skipped (%s) ===\n' "$app" "$reason"
            continue
        fi
        # An app without this target (a host tool has no `check`) is skipped. Any other probe
        # failure falls through to the real build, which reports it.
        probe_rc=0
        if ! probe_out="$(make -C "$app_dir" -n "$target" 2>&1)"; then probe_rc=1; fi
        if [ "$probe_rc" -ne 0 ] && printf '%s' "$probe_out" | grep -qE "No rule to make target ['\`]$target'"; then
            printf '=== %s: no %s target ===\n' "$app" "$target"
            continue
        fi
        printf '=== %s: %s ===\n' "$app" "$target"
        if ! make $JOBS -C "$app_dir" "$target"; then
            if is_payload "$app_dir"; then
                printf '=== %s: %s failed - a payload in development, not failing the run ===\n' "$app" "$target" >&2
            else
                exit 1
            fi
        fi
    done
    if [ "$any" -eq 0 ]; then
        echo "oops-apps: no apps here yet" >&2
        exit 1
    fi
}

# Stage each app's shippables. `make -n dist` asks whether an app has a `dist` target
# without building. Make's "No rule to make target 'dist'" means nothing to ship; any other
# probe failure (a refused toolchain, an incomplete fetch) fails the run.
distribute() {
    local any=0 shipped=0 failed=0
    for app in $(resolve "$@"); do
        any=1
        app_dir="$(resolve_app_dir "$app")"

        if reason="$(ci_skip_reason "$app_dir")"; then
            printf '=== %s: skipped (%s) ===\n' "$app" "$reason"
            continue
        fi

        # Inside `if`, because under `set -e` a failing bare assignment ends the script.
        probe_rc=0
        if ! probe_out="$(make -C "$app_dir" -n dist 2>&1)"; then
            probe_rc=1
        fi

        if [ "$probe_rc" -eq 0 ]; then
            printf '=== %s: dist ===\n' "$app"
            if make $JOBS -C "$app_dir" dist; then
                shipped=$((shipped + 1))
            elif is_payload "$app_dir"; then
                printf '=== %s: dist failed - a payload in development, not failing the run ===\n' "$app" >&2
            else
                failed=$((failed + 1))
            fi
        # The match names `dist`, because make says "No rule to make target" about a
        # missing prerequisite too.
        elif printf '%s' "$probe_out" | grep -qE "No rule to make target ['\`]dist'"; then
            printf '=== %s: no dist target, nothing to ship yet ===\n' "$app"
        elif is_payload "$app_dir"; then
            printf '=== %s: cannot be asked whether it ships - a payload in development ===\n' "$app" >&2
        else
            printf '=== %s: cannot be asked whether it ships ===\n' "$app" >&2
            printf '%s\n' "$probe_out" >&2
            failed=$((failed + 1))
        fi
    done
    if [ "$any" -eq 0 ]; then
        echo "oops-apps: no apps here yet" >&2
        exit 1
    fi
    printf 'dist: %s app(s) staged something to ship\n' "$shipped"
    if [ "$failed" -gt 0 ]; then
        printf 'dist: %s app(s) could not be asked - see above\n' "$failed" >&2
        exit 1
    fi
}

# clang-format over first-party C and C++, at the pinned clang major (toolchain.mk). A
# clang-format of that major on PATH runs directly; otherwise silkeh/clang:<major> runs it.
# Files are rewritten by redirection, not `clang-format -i`, because -i renames and a Windows
# bind mount refuses the rename.
format() {
    local major image files run
    major=$(sed -n 's/^OOPS_CLANG_MAJOR *:= *//p' toolchain.mk)
    image="silkeh/clang:$major"
    # Vendored upstream copies and generated files are not ours to format.
    local not_ours=(-e '^src/oops-deps/libcxx/src/rune_table\.c$'
        -e '^src/oops-deps/libjpeg-turbo/include/jversion\.h$'
        -e '^src/oops-deps/libpng/include/pnglibconf\.h$'
        -e '^src/oops-deps/opus/'
        -e '\.gen\.'
        -e '/shim/include/')
    # Temporary: uncommitted work in progress under these; the next formatting commit drops it.
    local held=(-e '^common/posix/' -e '^src/oops-payloads/porthole/'
        -e '^src/oops-utilities/oopsy-daisy/' -e '^src/oops-utilities/porthole-companion/')
    mapfile -t files < <(git ls-files '*.c' '*.h' '*.cpp' '*.hpp' '*.cc' |
        grep -v "${not_ours[@]}" "${held[@]}")

    if clang-format --version 2>/dev/null | grep -q "version $major\."; then
        run=()
    elif command -v docker >/dev/null 2>&1; then
        # Git Bash rewrites Unix-looking arguments; `pwd -W` gives the path the daemon mounts.
        run=(env MSYS_NO_PATHCONV=1 docker run --rm -v "$(pwd -W 2>/dev/null || pwd):/w"
            -w /w "$image")
    else
        echo "oops-apps: needs clang-format $major on PATH, or docker to run $image" >&2
        exit 1
    fi

    if [ "${1:-}" = "--check" ]; then
        "${run[@]}" clang-format --dry-run --Werror "${files[@]}"
        echo "oops-apps: formatting clean (${#files[@]} files)"
    else
        # shellcheck disable=SC2016
        "${run[@]}" sh -c \
            'for f; do clang-format "$f" > /tmp/fmt.out && cat /tmp/fmt.out > "$f"; done' \
            sh "${files[@]}"
        echo "oops-apps: formatted ${#files[@]} files"
    fi
}

make_app() {
    local target_app="${1:-}"
    [ -n "$target_app" ] || {
        echo "oops-apps: 'make' needs an app (e.g. ./bin/oops-apps make src/oops-titles/ship-of-harkinian)" >&2
        exit 1
    }
    shift

    local app_dir
    app_dir="$(resolve_app_dir "$target_app")" || {
        echo "oops-apps: no app '$target_app' (a directory with a Makefile under src/<category>/)" >&2
        exit 2
    }

    local app_name
    app_name="$(basename "$app_dir")"

    local -a make_args=()
    if [ "$#" -gt 0 ]; then
        make_args=("$@")
    else
        local default_target="all"
        if grep -qE '^[[:space:]]*package:' "$app_dir/Makefile" 2>/dev/null; then
            default_target="package"
        elif grep -qE '^[[:space:]]*title:' "$app_dir/Makefile" 2>/dev/null; then
            default_target="title"
        elif grep -qE '^[[:space:]]*FORMATS[[:space:]]*=.*title' "$app_dir/app.env" 2>/dev/null; then
            default_target="title"
        fi

        if grep -q 'SOH_ARMED' "$app_dir/Makefile" 2>/dev/null; then
            make_args+=("SOH_ARMED=1")
        elif grep -q 'SPGK_ARMED' "$app_dir/Makefile" 2>/dev/null; then
            make_args+=("SPGK_ARMED=1")
        fi

        make_args+=("$default_target")
    fi

    printf '=== %s: make %s ===\n' "$app_name" "${make_args[*]}"
    make $JOBS -C "$app_dir" "${make_args[@]}"
}

find_pros() {
    local root="$HERE/.."
    for candidate in \
        "$root/prosperous/target/release/pros" \
        "$root/prosperous/target/release/pros.exe" \
        "$root/prosperous/target/debug/pros" \
        "$root/prosperous/target/debug/pros.exe"; do
        if [ -x "$candidate" ] || [ -f "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    if command -v pros >/dev/null 2>&1; then
        command -v pros
        return 0
    fi
    if command -v pros.exe >/dev/null 2>&1; then
        command -v pros.exe
        return 0
    fi
    return 1
}

get_title_id() {
    local dir="$1"
    local id=""
    if [ -f "$dir/app.env" ]; then
        id="$(grep -E '^[[:space:]]*TITLE_ID[[:space:]]*=' "$dir/app.env" 2>/dev/null | head -1 | cut -d= -f2 | tr -d ' "\r\n')"
    fi
    if [ -z "$id" ] && [ -d "$dir/build/title" ]; then
        for sub in "$dir/build/title"/*; do
            if [ -d "$sub" ] && [ -f "$sub/eboot.bin" ]; then
                id="$(basename "$sub")"
                break
            fi
        done
    fi
    printf '%s' "$id"
}

to_host_path() {
    local target="$1"
    if command -v wslpath >/dev/null 2>&1; then
        local abs_target
        abs_target="$(cd "$target" 2>/dev/null && pwd)"
        wslpath -w "$abs_target" 2>/dev/null && return 0
    fi
    (cd "$target" 2>/dev/null && (pwd -W 2>/dev/null || pwd))
}

restore_app() {
    local target_app="${1:-}"
    [ -n "$target_app" ] || {
        echo "oops-apps: 'restore' needs an app (e.g. ./bin/oops-apps restore src/oops-titles/ship-of-harkinian)" >&2
        exit 1
    }
    shift

    local app_dir
    app_dir="$(resolve_app_dir "$target_app")" || {
        echo "oops-apps: no app '$target_app' (a directory with a Makefile under src/<category>/)" >&2
        exit 2
    }

    local app_name
    app_name="$(basename "$app_dir")"

    local title_id
    title_id="$(get_title_id "$app_dir")"
    if [ -z "$title_id" ]; then
        echo "oops-apps: could not determine TITLE_ID for '$app_name'" >&2
        exit 1
    fi

    local title_dir="$app_dir/build/title/$title_id"
    if [ ! -f "$title_dir/eboot.bin" ]; then
        printf 'oops-apps: %s title not built yet (no %s/eboot.bin) - building first...\n' "$app_name" "$title_dir"
        make_app "$target_app"
    fi

    if [ ! -d "$title_dir" ] || [ ! -f "$title_dir/eboot.bin" ]; then
        echo "oops-apps: missing title directory at $title_dir" >&2
        exit 1
    fi

    local pros_bin
    pros_bin="$(find_pros)" || {
        echo "oops-apps: 'pros' not found on PATH or in prosperous/target/release/." >&2
        echo "Build it with: cargo build --release --manifest-path prosperous/Cargo.toml" >&2
        exit 1
    }

    local -a pros_args=()
    local has_yes=0
    for arg in "$@"; do
        if [ "$arg" = "-y" ] || [ "$arg" = "--yes" ]; then
            has_yes=1
        fi
        pros_args+=("$arg")
    done
    if [ "$has_yes" -eq 0 ]; then
        pros_args=("-y" "${pros_args[@]}")
    fi

    local host_title_dir
    host_title_dir="$(to_host_path "$title_dir")"

    printf '=== %s: restoring %s to /data/homebrew/%s ===\n' "$app_name" "$host_title_dir" "$title_id"
    export MSYS_NO_PATHCONV=1
    "$pros_bin" restore "$host_title_dir" "/data/homebrew/$title_id" "${pros_args[@]}"
}

usage() {
    sed -n '2,15p' "$0" | sed 's|^# \{0,1\}||'
    exit "${1:-0}"
}

cmd="${1:-list}"
shift || true
case "$cmd" in
    list) apps ;;
    build) over all "$@" ;;
    make) make_app "$@" ;;
    restore) restore_app "$@" ;;
    check)
        format --check
        over check "$@"
        ;;
    fmt) format "$@" ;;
    dist) distribute "$@" ;;
    clean) over clean "$@" ;;
    -h | --help | help) usage ;;
    *)
        echo "unknown verb: $cmd" >&2
        usage 1
        ;;
esac

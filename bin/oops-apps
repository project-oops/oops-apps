#!/usr/bin/env bash
# oops-apps - the dev CLI for the apps built on oops-sdk.
#
# The same verbs every OOPS repository carries, reaching each app through its own Makefile:
#
#   ./bin/oops-apps list              # the apps here
#   ./bin/oops-apps build [app...]    # build each (default: all)
#   ./bin/oops-apps check [app...]    # each app's own gate (default: all)
#   ./bin/oops-apps fmt [--check]     # clang-format first-party C and C++ in place
#   ./bin/oops-apps dist [app...]     # stage each app's shippable artifacts under <app>/dist/
#   ./bin/oops-apps clean [app...]    # remove build output
#
# An app is a directory with a Makefile. There is no registry to keep in step: the directory
# listing is the list, so an app that exists is an app this builds, and one that does not
# cannot be forgotten out of a table.
#
# # The release contract
#
# `dist` is how an app says what it ships and in what shape. Each app's Makefile provides a
# `dist` target that puts its release artifacts under `dist/` - a plain `.elf` payload, a
# `.zip` title directory, a `.pkg`, whatever the app is. This script and CI never learn a
# format: they run `make dist` and take whatever `dist/` holds. An app with no `dist` target
# ships nothing yet, and that is said out loud rather than failed - a demo without a release
# is a normal state, a silent empty release is not.
set -euo pipefail

cd "$(dirname "$0")/.."
HERE="$PWD"

# Every app under src/, one per line, as a bare name.
#
# Apps are filed by category - `src/oops-gl/gl1-cube` - so the glob is two deep. **The name
# stays bare**: `oops-apps dist gl1-cube` should not have to know which category something is
# filed under, CI's artefact names would change if it did, and an app moving between categories
# should not be a rename.
apps() {
    for d in src/*/*/; do
        [ -f "$HERE/${d}Makefile" ] && {
            name="${d%/}"
            printf '%s\n' "${name##*/}"
        }
    done
}

# Where an app of this name lives, or nothing. **Two categories carrying the same app name is
# refused rather than resolved**: bare names are only usable as identifiers while they are
# unique, and silently picking whichever the glob reached first is how the wrong thing gets
# built for a long time before anybody notices.
app_path() {
    local want="$1" found="" d
    for d in "$HERE"/src/*/"$want"; do
        [ -f "$d/Makefile" ] || continue
        if [ -n "$found" ]; then
            echo "oops-apps: '$want' exists in more than one category ($found and $d)" >&2
            exit 2
        fi
        found="$d"
    done
    [ -n "$found" ] && printf '%s\n' "$found"
}

# The apps to act on: the ones named, or all of them. A named directory without a Makefile is
# a mistake worth stopping on rather than skipping past.
resolve() {
    if [ "$#" -eq 0 ]; then
        apps
        return
    fi
    for name in "$@"; do
        if [ -n "$(app_path "$name")" ] || [ -f "$HERE/$name/Makefile" ]; then
            printf '%s\n' "$name"
        else
            echo "oops-apps: no app '$name' (a directory with a Makefile under src/<category>/)" >&2
            exit 2
        fi
    done
}

# An app CI cannot build here: one held out with `CI_SKIP=1`, or a Mesa title when there is no
# oops-mesa build to link against (the plain build and the `check` gate have none - those titles
# are built in the release's own oops-mesa job). Prints the reason and returns 0 to skip; 1 to
# build.
ci_skip_reason() {
    local dir="$1"
    if grep -qE '^[[:space:]]*CI_SKIP[[:space:]]*=[[:space:]]*1' "$dir/app.env" 2>/dev/null; then
        printf 'held out of CI (CI_SKIP=1)'
        return 0
    fi
    if grep -qE 'OOPS_RENDERER[[:space:]]*[:?]?=[[:space:]]*mesa|USE_MESA[[:space:]]*[:?]?=[[:space:]]*1' \
             "$dir/Makefile" "$dir/app.env" 2>/dev/null && [ ! -e "$HERE/../oops-mesa/build/mesa" ]; then
        printf 'a Mesa title, and there is no oops-mesa build here'
        return 0
    fi
    return 1
}

# A developer payload (KIND=payload) - built if it can be, but a build failure does not fail the
# run: a payload mid-development is a normal state, the same way an app with no dist target is.
is_payload() {
    grep -qE '^[[:space:]]*KIND[[:space:]]*=[[:space:]]*payload' "$1/app.env" 2>/dev/null
}

over() {
    local target="$1"
    shift
    local any=0
    for app in $(resolve "$@"); do
        any=1
        app_dir="$(app_path "$app")"
        [ -n "$app_dir" ] || app_dir="$HERE/$app"
        if reason="$(ci_skip_reason "$app_dir")"; then
            printf '=== %s: skipped (%s) ===\n' "$app" "$reason"
            continue
        fi
        # An app may not have this target at all - a standalone host tool has no `check`, for
        # instance. Skip it the way `dist` skips an app with no dist target, rather than stopping
        # the whole run on it. Only a genuine "No rule to make target" is skipped; any other
        # probe failure falls through to the real build, which reports it.
        probe_rc=0
        if ! probe_out="$(make -C "$app_dir" -n "$target" 2>&1)"; then probe_rc=1; fi
        if [ "$probe_rc" -ne 0 ] && printf '%s' "$probe_out" | grep -qE "No rule to make target ['\`]$target'"; then
            printf '=== %s: no %s target ===\n' "$app" "$target"
            continue
        fi
        printf '=== %s: %s ===\n' "$app" "$target"
        if ! make -C "$app_dir" "$target"; then
            if is_payload "$app_dir"; then
                printf '=== %s: %s failed - a payload in development, not failing the run ===\n' "$app" "$target" >&2
            else
                exit 1
            fi
        fi
    done
    if [ "$any" -eq 0 ]; then
        echo "oops-apps: no apps here yet" >&2
        exit 1
    fi
}

# Stage each app's shippables, and say which apps have nothing to ship yet rather than
# failing on them - see the release contract in the header. An app declares it ships by
# carrying a `dist` target; `make -n` asks whether it does without building anything.
#
# **"No dist target" and "the probe failed" are different answers, and this used to give the
# first for both.** `make -n dist` can fail for reasons that have nothing to do with whether the
# target exists: a toolchain the Makefile refuses, an upstream fetch that did not complete, a
# syntax error in an included file. Its output went to /dev/null, so every one of those was
# reported as an app with nothing to ship - a sentence that is a normal state, printed under a
# green tick.
#
# That hid a dead release for four days. The collection was pinned to clang 21 while CI
# installed clang 18; every app's probe failed the version check, every app was reported as
# having nothing to ship, the publish job downloaded nothing, and the rolling `latest-main`
# release simply stopped moving while every run passed. Nothing in the logs said otherwise,
# because the workflow had no way to tell the two apart.
#
# So the probe now reads its own output. Make says `No rule to make target 'dist'` when the
# target genuinely is not there; anything else is a failure worth seeing and worth failing on,
# because an app that cannot even be asked is not an app with nothing to ship.
distribute() {
    local any=0 shipped=0 failed=0
    for app in $(resolve "$@"); do
        any=1
        app_dir="$(app_path "$app")"
        [ -n "$app_dir" ] || app_dir="$HERE/$app"

        if reason="$(ci_skip_reason "$app_dir")"; then
            printf '=== %s: skipped (%s) ===\n' "$app" "$reason"
            continue
        fi

        # The assignment sits inside `if` because this script runs under `set -e`, where a bare
        # `probe_out="$(failing command)"` ends the script on the spot and never reaches the `$?`
        # that was meant to read it. A condition is the one place a failure is allowed to be an
        # answer rather than the end.
        probe_rc=0
        if ! probe_out="$(make -C "$app_dir" -n dist 2>&1)"; then
            probe_rc=1
        fi

        if [ "$probe_rc" -eq 0 ]; then
            printf '=== %s: dist ===\n' "$app"
            if make -C "$app_dir" dist; then
                shipped=$((shipped + 1))
            elif is_payload "$app_dir"; then
                printf '=== %s: dist failed - a payload in development, not failing the run ===\n' "$app" >&2
            else
                failed=$((failed + 1))
            fi
        # **`dist` specifically.** Make says "No rule to make target" about a missing
        # prerequisite too, and matching the phrase alone read a title whose sources had not
        # arrived as a title that ships nothing - the same confusion one layer down.
        elif printf '%s' "$probe_out" | grep -qE "No rule to make target ['\`]dist'"; then
            printf '=== %s: no dist target, nothing to ship yet ===\n' "$app"
        elif is_payload "$app_dir"; then
            printf '=== %s: cannot be asked whether it ships - a payload in development ===\n' "$app" >&2
        else
            printf '=== %s: cannot be asked whether it ships ===\n' "$app" >&2
            printf '%s\n' "$probe_out" >&2
            failed=$((failed + 1))
        fi
    done
    if [ "$any" -eq 0 ]; then
        echo "oops-apps: no apps here yet" >&2
        exit 1
    fi
    printf 'dist: %s app(s) staged something to ship\n' "$shipped"
    if [ "$failed" -gt 0 ]; then
        printf 'dist: %s app(s) could not be asked - see above\n' "$failed" >&2
        exit 1
    fi
}

# clang-format over first-party C and C++, at the pinned clang major (toolchain.mk). A
# clang-format of that major on PATH runs directly; otherwise silkeh/clang:<major> runs it.
# Files are rewritten by redirection, not `clang-format -i`, because -i renames and a Windows
# bind mount refuses the rename.
format() {
    local major image files run
    major=$(sed -n 's/^OOPS_CLANG_MAJOR *:= *//p' toolchain.mk)
    image="silkeh/clang:$major"
    # Vendored upstream copies and generated files are not ours to format.
    local not_ours=(-e '^src/oops-deps/libcxx/src/rune_table\.c$'
        -e '^src/oops-deps/libjpeg-turbo/include/jversion\.h$'
        -e '^src/oops-deps/libpng/include/pnglibconf\.h$')
    # Temporary: uncommitted work in progress under these; the next formatting commit drops it.
    local held=(-e '^common/posix/' -e '^src/oops-payloads/porthole/'
        -e '^src/oops-utilities/oopsy-daisy/' -e '^src/oops-utilities/porthole-companion/')
    mapfile -t files < <(git ls-files '*.c' '*.h' '*.cpp' '*.hpp' '*.cc' |
        grep -v "${not_ours[@]}" "${held[@]}")

    if clang-format --version 2>/dev/null | grep -q "version $major\."; then
        run=()
    elif command -v docker >/dev/null 2>&1; then
        # Git Bash rewrites Unix-looking arguments; `pwd -W` gives the path the daemon mounts.
        run=(env MSYS_NO_PATHCONV=1 docker run --rm -v "$(pwd -W 2>/dev/null || pwd):/w"
            -w /w "$image")
    else
        echo "oops-apps: needs clang-format $major on PATH, or docker to run $image" >&2
        exit 1
    fi

    if [ "${1:-}" = "--check" ]; then
        "${run[@]}" clang-format --dry-run --Werror "${files[@]}"
        echo "oops-apps: formatting clean (${#files[@]} files)"
    else
        # shellcheck disable=SC2016
        "${run[@]}" sh -c \
            'for f; do clang-format "$f" > /tmp/fmt.out && cat /tmp/fmt.out > "$f"; done' \
            sh "${files[@]}"
        echo "oops-apps: formatted ${#files[@]} files"
    fi
}

usage() {
    sed -n '2,13p' "$0" | sed 's|^# \{0,1\}||'
    exit "${1:-0}"
}

cmd="${1:-list}"
shift || true
case "$cmd" in
    list) apps ;;
    build) over all "$@" ;;
    check) over check "$@" ;;
    fmt) format "$@" ;;
    dist) distribute "$@" ;;
    clean) over clean "$@" ;;
    -h | --help | help) usage ;;
    *)
        echo "unknown verb: $cmd" >&2
        usage 1
        ;;
esac

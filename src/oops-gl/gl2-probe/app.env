# gl2-probe's identity.
#
# An explicit id, because the name-derived one collides with other `g` apps. `GLTP00001` is
# GL Two Probe, matching `GLTC00001` for GL Two Cube: four letters, five digits, no digit
# among the letters, which the console's installer requires and app.mk checks.
EXPLICIT_TITLE_ID=1
TITLE_ID=GLTP00001
TITLE_NAME="GL2 Probe"
APP_SUBTITLE="OpenGL 2.0 conformance probe"
TITLE_CATEGORY=big-app
KIND=probe
TITLE_VERSION=01.00
FORMATS=eboot title

EXPLICIT_TITLE_ID=1
# **An explicit id, because the derived one collides.**
#
# app.mk synthesises a title id as target-tag + first letter + five digits, so every app whose
# name starts with `g` and ends `00001` lands on the same `PROG00001` - `gallery`, `gl1-probe`
# and `gl2-cube` all did. Two titles with one id are indistinguishable to the loader and to
# `pros launch`, which is a confusing way to install the wrong thing.
#
# **Four letters, then five digits, and the letters may not contain a digit.** This was
# `GL1P00001` until 2026-09-17, which looks like an id and is not one: `GL1P` has a `1` in the
# letter field. The console's own installer is the thing that refuses it -
# `20 Invalid TitleId : [GL1P00001]`, then `AppPromote Error ... 0x80bd000a` - so the directory
# stages onto the target perfectly and is then never indexed, and nothing on the host side says
# a word. app.mk now checks the shape, so an id of the wrong form stops the build instead.
TITLE_ID=GLPB00001
TITLE_NAME="GL1 Probe"
APP_SUBTITLE="OpenGL 1.3 hardware conformance & differential rasterizer probe"
TITLE_CATEGORY=big-app
TITLE_VERSION=01.00
FORMATS=elf eboot title

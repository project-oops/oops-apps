EXPLICIT_TITLE_ID=1
# An explicit id, because the derived one (target tag + first letter + five digits)
# collides with every other app starting with `g`.
#
# A title id is four letters then five digits, with no digit in the letter field; the
# console's installer rejects any other shape, and app.mk checks it.
TITLE_ID=GLPB00001
TITLE_NAME="GL1 Probe"
APP_SUBTITLE="OpenGL 1.3 hardware conformance & differential rasterizer probe"
TITLE_CATEGORY=big-app
KIND=probe
TITLE_VERSION=01.00
FORMATS=elf eboot title

EXPLICIT_TITLE_ID=1
# **GLCB00001 is kept although the app is now gl1-cube.**
#
# The AGC oracle record (oops-sdk/docs/hardware/agc-gl-cube-oracle-fw1240.md) documents a frame
# measured on a retail console from *this title id*, and its stop file and launch command name
# it. The record describes something that happened; renaming the directory does not change what
# was measured, and changing the id would leave the record describing a title that no longer
# exists. A new id here would buy tidiness and cost provenance.
TITLE_ID=GLCB00001
TITLE_NAME="GL1 Cube"
APP_SUBTITLE="Freestanding hardware-accelerated OpenGL 1.3 demonstration"
TITLE_CATEGORY=big-app
TITLE_VERSION=01.00
FORMATS=elf eboot title

# An explicit id, because the name-derived one collides with other `g` apps.
#
# Four letters, then five digits, with no digit in the letter field; the console's installer
# rejects any other shape, and app.mk checks it.
EXPLICIT_TITLE_ID=1
TITLE_ID=GLTC00001
TITLE_NAME="GL2 Cube"
APP_SUBTITLE="Programmable shader pipeline OpenGL 2.0 demonstration"
TITLE_CATEGORY=big-app
KIND=demo
TITLE_VERSION=01.00
# No `elf`: that format stages the bare ELF for a homebrew loader, and this collection installs
# native titles.
FORMATS=eboot title

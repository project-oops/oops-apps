index a369528..88ae096 100644
--- a/src/states_screens/help/help_screen_7.cpp
+++ b/src/states_screens/help/help_screen_7.cpp
@@ -17,6 +17,11 @@
 
 // Manages includes common to all help screens
 #include "states_screens/help/help_common.hpp"
+#include "guiengine/widgets/label_widget.hpp"
+#include "input/device_manager.hpp"
+#include "input/gamepad_config.hpp"
+#include "input/gamepad_device.hpp"
+#include "input/input_manager.hpp"
 
 using namespace GUIEngine;
 
@@ -62,6 +67,45 @@ void HelpScreen7::init()
         w->setFocusForPlayer(PLAYER_ID_GAME_MASTER);
         w->select( "page7", PLAYER_ID_GAME_MASTER );
     }
+
+    // The card reads the connected pad's configuration, or the first gamepad
+    // configuration when no pad is connected yet.
+    DeviceManager* dm = input_manager->getDeviceManager();
+    DeviceConfig* config = NULL;
+    if (dm->getGamePadAmount() > 0 && dm->getGamePad(0) != NULL)
+        config = dm->getGamePad(0)->getConfiguration();
+    else if (dm->getGamePadConfigAmount() > 0)
+        config = dm->getGamepadConfig(0);
+
+    const struct { const char* id; PlayerAction action; } rows[] =
+    {
+        { "b_accel", PA_ACCEL },     { "b_brake", PA_BRAKE },
+        { "b_fire", PA_FIRE },       { "b_nitro", PA_NITRO },
+        { "b_drift", PA_DRIFT },     { "b_look", PA_LOOK_BACK },
+        { "b_rescue", PA_RESCUE },   { "b_pause", PA_PAUSE_RACE },
+    };
+    for (const auto& r : rows)
+    {
+        LabelWidget* l = getWidget<LabelWidget>(r.id);
+        if (l == NULL)
+            continue;
+        l->setText(config ? config->getBindingAsString(r.action)
+                          : irr::core::stringw(L"-"), false);
+        l->setColor(irr::video::SColor(255, 255, 210, 60));
+    }
+    LabelWidget* steer = getWidget<LabelWidget>("b_steer");
+    if (steer != NULL)
+    {
+        irr::core::stringw s = L"-";
+        if (config)
+        {
+            s = config->getBindingAsString(PA_STEER_LEFT);
+            s += L" / ";
+            s += config->getBindingAsString(PA_STEER_RIGHT);
+        }
+        steer->setText(s, false);
+        steer->setColor(irr::video::SColor(255, 255, 210, 60));
+    }
 }   // init
 

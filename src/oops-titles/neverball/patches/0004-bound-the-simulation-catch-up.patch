index 0fbc7d0..2954a61 100644
--- a/ball/game_common.c
+++ b/ball/game_common.c
@@ -213,14 +213,48 @@ void lockstep_clr(struct lockstep *ls)
     ls->ts = 1.0f;
 }
 
+/* **The catch-up is bounded, so a slow frame cannot make the next one slower.**
+ *
+ * The accumulator runs the simulation at a fixed rate - ninety steps a second - by stepping it
+ * as many times as the elapsed time asks for. On a desktop that is one or two steps a frame and
+ * the loop below is right as written.
+ *
+ * On a console whose frame takes longer than a step, it is a spiral. `dt` is the time the last
+ * frame took, so a slow frame asks for more steps, and running them makes the next frame slower
+ * still, which asks for more again. Measured on 2026-09-24: a level ran eleven frames spending
+ * 1,647ms in this function and then **one frame that spent 42,873ms in it** - forty-three
+ * seconds of one frame, thousands of iterations deep, with nothing wrong anywhere else. The
+ * menu and the Ready/Set/GO animation were smooth, because neither steps the simulation; it
+ * began the instant the player was given control, and it read as the game freezing.
+ *
+ * So the backlog is capped. Past the cap the remaining time is dropped rather than carried,
+ * because carrying it is what closes the loop: the simulation then runs slow - in slow motion,
+ * visibly - instead of running away, and it recovers by itself as soon as frames are quick
+ * enough to keep up. Sixteen steps is a fifth of a second of catch-up, comfortably more than a
+ * healthy frame needs and far less than a spiral.
+ *
+ * **The real fix is a frame that does not take a fifth of a second**, and this does not
+ * substitute for it. It stops the failure being unbounded.
+ */
+#define LOCKSTEP_MAX_CATCHUP 16
+
 void lockstep_run(struct lockstep *ls, float dt)
 {
+    int steps = 0;
+
     ls->at += dt * ls->ts;
 
     while (ls->at >= ls->dt)
     {
+        if (steps >= LOCKSTEP_MAX_CATCHUP)
+        {
+            ls->at = 0.0f;
+            break;
+        }
+
         ls->step(ls->dt);
         ls->at -= ls->dt;
+        steps++;
     }
 }
 

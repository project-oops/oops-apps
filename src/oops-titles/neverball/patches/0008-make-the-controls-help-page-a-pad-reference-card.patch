+/*
+ * **The pad, not the keyboard.**
+ *
+ * Upstream lists key names here, which is the right page for a desktop and the wrong one for a
+ * console: there is no keyboard in the room, and the one thing a player genuinely cannot work
+ * out for themselves is which of the four face buttons changes the camera.
+ *
+ * So this is a reference card - the shared controller wireframe from `common/assets/controls`,
+ * with the bindings beside it. It is read-only on purpose. Rebinding is a bigger screen than
+ * this port needs, and the names on the left are the *actions*, which do not change when a
+ * future upstream renumbers a button.
+ *
+ * The bindings are read from the same `CONFIG_JOYSTICK_*` values the play state tests
+ * (`ball/st_play.c:548-566`, `:92`), rather than written out as prose, so a card that disagrees
+ * with the game is not possible.
+ */
+static void help_binding(int id, const char *action, const char *button)
+{
+    int kd;
+
+    if ((kd = gui_harray(id)))
+    {
+        gui_label(kd, button, GUI_SML, gui_yel, gui_yel);
+        gui_label(kd, action, GUI_SML, gui_wht, gui_wht);
+    }
+}

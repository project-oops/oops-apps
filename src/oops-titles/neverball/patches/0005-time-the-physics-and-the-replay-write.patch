+#include "SDL.h" /* SDL_GetTicks, for the per-phase timing below */
+#include "log.h"
 #include "gui.h"
 #include "hud.h"
 #include "demo.h"
@@ -392,8 +394,38 @@ static void play_loop_timer(int id, float dt)
 
     game_step_fade(dt);
 
-    game_server_step(dt);
-    game_client_sync(demo_fp);
+    /* **The physics and the demo writing, separately, once a second.**
+     *
+     * The frame timing in `main` put the whole frame in this state's timer - about 2.2 seconds
+     * of it - and the two candidates inside it are opposite problems. `game_server_step` is
+     * arithmetic and would mean the solver is slow; `game_client_sync` writes the replay to
+     * `<HOME>/.neverball/Replays` through `demo_fp`, and file I/O on this filesystem is not
+     * quick. Splitting them is four clock reads, and it is the difference between optimising a
+     * solver and buffering a file. */
+    {
+        static Uint32 acc_step = 0, acc_sync = 0, acc_n = 0, at = 0;
+        Uint32 a, b;
+
+        a = SDL_GetTicks();
+        game_server_step(dt);
+        b = SDL_GetTicks(); acc_step += b - a;
+
+        a = SDL_GetTicks();
+        game_client_sync(demo_fp);
+        b = SDL_GetTicks(); acc_sync += b - a;
+
+        acc_n++;
+
+        if (at == 0) at = SDL_GetTicks() + 1000;
+        if (SDL_GetTicks() >= at)
+        {
+            log_printf("play: %u steps, server %ums, sync %ums, demo %s\n",
+                       acc_n, acc_step, acc_sync, demo_fp ? "on" : "off");
+            acc_step = acc_sync = acc_n = 0;
+            at = SDL_GetTicks() + 1000;
+        }
+    }
+
     game_client_blend(game_server_blend());
 
     switch (curr_status())

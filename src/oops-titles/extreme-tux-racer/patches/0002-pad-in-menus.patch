+// **The pad, as the keys the menus already understand.**
+//
+// Every menu screen in ETR registers a `keyb` handler and NULL for the joystick, so rather than
+// teaching seventeen screens about a controller, one translation here covers all of them: a pad
+// press arrives at exactly the handler the same keypress would, and no screen's own code changes.
+//
+// The mapping is the console's convention rather than SDL's button order:
+//   cross -> Return, circle -> Escape, triangle -> Tab, square -> Backspace
+// and the D-pad hat to the four arrows. `PROSPERO_BTN_*` in the SDL backend puts cross at 0 and
+// circle at 1, which is SDL_GameController order.
+unsigned int CWinsys::PadButtonKey (int button) {
+	switch (button) {
+		case 0: return SDLK_RETURN;     // cross
+		case 1: return SDLK_ESCAPE;     // circle
+		case 2: return SDLK_TAB;        // triangle
+		case 3: return SDLK_BACKSPACE;  // square
+
+		// **The race needs more than the menus do, and had none of it.**
+		//
+		// The four above are enough to drive every menu, which is what this translation was
+		// written for. A race is not a menu: `racing.cpp` charges a jump on SDLK_SPACE, turns a
+		// trick on SDLK_t and pauses on SDLK_p, and none of those had a button - so the game was
+		// navigable with a pad and not fully playable with one. The D-pad already steers,
+		// paddles and brakes through the hat.
+		//
+		// Indices are `SDL_GameControllerButton` order, which is what this platform's backend
+		// reports (`oops-deps/sdl2/backend/SDL_prosperojoystick.c`): 6 Options, 9 and 10 the
+		// shoulders.
+		//
+		// Harmless in the menus, which is what makes one flat table workable: no menu screen
+		// binds space, `t` or `p`.
+		case 6:  return SDLK_p;         // Options - pause
+		case 9:  return SDLK_t;         // L1 - trick modifier
+		case 10: return SDLK_SPACE;     // R1 - charge a jump
+
+		default: return 0;
+	}
+}
+
+void CWinsys::PadAsKey (unsigned int key, bool release) {
+	int x, y;
+	if (key == 0) return;
+	if (modefuncs[g_game.mode].keyb) {
+		SDL_GetMouseState (&x, &y);
+		(modefuncs[g_game.mode].keyb) (key, key >= 256, release, x, y);
+	} else if (modefuncs[g_game.mode].keyb_spec) {
+		SDL_Keysym sym;
+		memset (&sym, 0, sizeof (sym));
+		sym.sym = (SDL_Keycode)key;
+		(modefuncs[g_game.mode].keyb_spec) (sym, release);
+	}
+}
+
+// A hat reports a direction, not a transition, so the previous value is what says which arrows
+// were released and which were pressed. Without that a held direction would repeat forever and a
+// released one would never come up.
+void CWinsys::PadHat (int value) {
+	static const struct { int bit; unsigned int key; } dirs[] = {
+		{SDL_HAT_UP,    SDLK_UP},
+		{SDL_HAT_DOWN,  SDLK_DOWN},
+		{SDL_HAT_LEFT,  SDLK_LEFT},
+		{SDL_HAT_RIGHT, SDLK_RIGHT},
+	};
+	for (int i = 0; i < 4; i++) {
+		const bool was = (last_hat & dirs[i].bit) != 0;
+		const bool now = (value & dirs[i].bit) != 0;
+		if (now && !was) PadAsKey (dirs[i].key, false);
+		else if (was && !now) PadAsKey (dirs[i].key, true);
+	}
+	last_hat = value;
+}

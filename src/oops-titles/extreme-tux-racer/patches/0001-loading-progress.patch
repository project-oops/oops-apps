--- a/winsys.h
+++ b/winsys.h
@@ -92,6 +92,19 @@ public:
 	void ShowCursor (bool visible) {SDL_ShowCursor (visible);}
 	void SwapBuffers ();
 	void Delay (unsigned int ms);
+
+	// **Loading progress, which ETR 0.6 does not have.**
+	//
+	// Every load here is synchronous with the screen frozen on whatever was last drawn: the
+	// splash screen at startup, and "Loading resources, please wait ..." when a course is
+	// chosen. On a desktop that is a second and nobody notices. On this console it is long
+	// enough that a player cannot tell loading from a hang - which is exactly what happened,
+	// and the report was "seems stuck".
+	//
+	// `progress_ready` is false until the fonts are loaded, because before that there is
+	// nothing to draw text with; `ShowProgress` still reports to the log in that window.
+	bool progress_ready;
+	void ShowProgress (const string &what, int done, int total);
 	void Quit ();
 	void InitJoystick ();
 	void CloseJoystick ();

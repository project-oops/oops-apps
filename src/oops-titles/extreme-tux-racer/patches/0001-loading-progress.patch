 void CWinsys::SetFonttype () {
     const char* font = (param.use_papercut_font > 0 ? "pc20" : "bold");
     FT.SetFont (font);
+    // The one call that happens exactly once, immediately after `FT.LoadFontlist`, so it is where
+    // "there is now a font to draw progress with" becomes true. Nothing at the call site changes.
+    progress_ready = true;
+}
+
+// **What is loading, and how far through it is.** See the note in winsys.h for why this exists.
+//
+// Two rates, deliberately. The log line is printed for every call, because a log that skips is
+// useless for finding where a load stopped. The *screen* is redrawn at most every 120 ms: a
+// redraw here is a full frame - and on this target a frame of text rebuilds the font atlas - so
+// drawing one per texture would make the load it is reporting on measurably slower.
+void CWinsys::ShowProgress (const string &what, int done, int total) {
+    static Uint32 last_draw = 0;
+
+    if (total > 0) printf ("loading: %s  %d/%d\n", what.c_str(), done, total);
+    else printf ("loading: %s\n", what.c_str());
+
+    if (!progress_ready) return;
+
+    const Uint32 now = SDL_GetTicks ();
+    const bool last_step = (total > 0 && done >= total);
+    if (!last_step && last_draw != 0 && now - last_draw < 120) return;
+    last_draw = now;
+
+    ClearRenderContext ();
+    set_gl_options (GUI);
+    SetupGuiDisplay ();
+
+    Tex.Draw (TEXLOGO, CENTER, 40, 0.7);
+
+    FT.SetColor (colDYell);
+    FT.AutoSizeN (4);
+    FT.DrawString (CENTER, AutoYPosN (58), what);
+
+    if (total > 0) {
+        FT.SetColor (colWhite);
+        FT.AutoSizeN (3);
+        FT.DrawString (CENTER, AutoYPosN (66), Int_StrN (done) + " / " + Int_StrN (total));
+
+        // The bar itself, in ETR's own widget colours: an empty frame with a filled part on top.
+        const int w = (int)(param.x_resolution * 0.5);
+        const int h = 18;
+        const int x = (param.x_resolution - w) / 2;
+        const int y = AutoYPosN (74);
+        int fill = (int)((double)w * (double)done / (double)total);
+        if (fill < 0) fill = 0;
+        if (fill > w) fill = w;
+        DrawFrameX (x, y, w, h, 3, colMBackgr, colWhite, 1.0);
+        if (fill > 0) DrawFrameX (x, y, fill, h, 0, colDYell, colDYell, 1.0);
+    }
+
+    SwapBuffers ();
 }
 

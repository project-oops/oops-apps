Seed from rand() here, as on the other consoles

`std::random_device` needs an entropy source this platform does not have, so
`oops-deps/libcxx` is built with `_LIBCPP_HAS_RANDOM_DEVICE 0` and the type does not exist.
Upstream already falls back to `rand()` on Switch and Wii U for the same reason; this adds
this console to that list rather than introducing a third path.

`rand()` with no `srand` is a fixed sequence, so the entry point seeds it from the clock.
That is outside upstream's tree, in `shim/2s2h_start.c`.
---
diff --git a/mm/2s2h/BenGui/UIWidgets.cpp b/mm/2s2h/BenGui/UIWidgets.cpp
index d13fdbc..eac241e 100644
--- a/mm/2s2h/BenGui/UIWidgets.cpp
+++ b/mm/2s2h/BenGui/UIWidgets.cpp
@@ -1401,7 +1401,7 @@ bool CVarBtnSelector(const char* label, const char* cvarName, const BtnSelectorO
 } // namespace UIWidgets
 
 ImVec4 GetRandomValue() {
-#if !defined(__SWITCH__) && !defined(__WIIU__)
+#if !defined(__SWITCH__) && !defined(__WIIU__) && !defined(__PROSPERO__)
     std::random_device rd;
     std::mt19937 rng(rd());
 #else
diff --git a/mm/2s2h/Enhancements/Audio/AudioEditor.cpp b/mm/2s2h/Enhancements/Audio/AudioEditor.cpp
index 985740a..facd628 100644
--- a/mm/2s2h/Enhancements/Audio/AudioEditor.cpp
+++ b/mm/2s2h/Enhancements/Audio/AudioEditor.cpp
@@ -216,8 +216,12 @@ void RandomizeGroup(SeqType type) {
         return;
     }
 
+#if !defined(__SWITCH__) && !defined(__WIIU__) && !defined(__PROSPERO__)
     std::random_device rd;
     std::mt19937 g(rd());
+#else
+    std::mt19937 g(rand());
+#endif
     std::shuffle(uncategorized.begin(), uncategorized.end(), g);
 
     std::map<int, std::vector<std::shared_ptr<SequenceReplacement>>> seqPools = {};

diff --git a/libultraship/src/ship/window/gui/Gui.cpp b/libultraship/src/ship/window/gui/Gui.cpp
index 1f9279b..96b1979 100644
--- a/libultraship/src/ship/window/gui/Gui.cpp
+++ b/libultraship/src/ship/window/gui/Gui.cpp
@@ -94,12 +94,26 @@ void Gui::Init() {
         mImGuiIo->ConfigFlags |= ImGuiConfigFlags_ViewportsEnable;
     }
 
+#ifdef __PROSPERO__
+    // A console has no mouse, so controller navigation is not a preference here - it is the
+    // only way anything on screen can be answered. Both conditions below fail on this
+    // platform for reasons that have nothing to do with intent: the CVar defaults to 0, and
+    // the first thing a player meets is a popup rather than the menubar, so
+    // `GetMenuOrMenubarVisible()` is false. The `else` then clears the flag every frame.
+    //
+    // What that looked like: "No O2R files found. Generate one now?" with Yes and No, a
+    // cursor that does not move, and no way to reach either button - while the pad was
+    // connected and SDL was reporting it.
+    mImGuiIo->ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+    mImGuiIo->ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard;
+#else
     if (Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger(CVAR_IMGUI_CONTROLLER_NAV, 0) &&
         GetMenuOrMenubarVisible()) {
         mImGuiIo->ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
     } else {
         mImGuiIo->ConfigFlags &= ~ImGuiConfigFlags_NavEnableGamepad;
     }
+#endif
 
     GetGuiWindow("Stats")->Init();
     GetGuiWindow("Console")->Init();

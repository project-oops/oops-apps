 #include "ExporterArchiveO2R.h"
 #include "Utils/StringHelper.h"
 #include <ship/utils/StrHash64.h>
+#include <atomic>
 #include <filesystem>
 #include <spdlog/spdlog.h>
 
+/*
+ * How far through writing the archive we are, 0 to 1, for whoever is drawing a progress
+ * bar. Defined here because this is where it is known and set; `OTRGlobals` declares it
+ * `extern` and reads it.
+ *
+ * Atomic because the write runs on the extraction worker and the bar is drawn on the
+ * frame thread. A plain double would be read torn on some architectures and is not worth
+ * the argument.
+ */
+std::atomic<double> gOtrArchiveProgress{0.0};
+
 ExporterArchiveO2R::ExporterArchiveO2R(const std::string& path, bool enableWriting) {
     mPath = path;
     mZip = nullptr;
@@ -52,7 +64,43 @@ bool ExporterArchiveO2R::Unload() {
 int ExporterArchiveO2R::CreateArchive([[maybe_unused]] size_t fileCapacity) {
     int openErr;
     zip_t* zip;
-    
+
+    /*
+     * Clear any temporary archive left by a run that did not finish.
+     *
+     * libzip writes to `<name>.XXXXXX.part` and renames it into place when the archive
+     * closes. A run interrupted during that write - and it is the longest step, minutes of
+     * it - leaves the part file behind, and nothing ever collects it. Two of them, 29MB
+     * between them, accumulated here from two interrupted attempts before anybody noticed.
+     *
+     * This is the right moment: the archive is about to be written afresh, so any earlier
+     * temporary for the same target is known to be dead. Failures are ignored on purpose -
+     * not being able to tidy up is not a reason to refuse to convert a ROM.
+     */
+    try {
+        const std::filesystem::path target(mPath);
+        const std::filesystem::path dir =
+            target.has_parent_path() ? target.parent_path() : std::filesystem::path(".");
+        const std::string prefix = target.filename().string() + ".";
+
+        for (const auto& entry : std::filesystem::directory_iterator(dir)) {
+            if (!entry.is_regular_file()) {
+                continue;
+            }
+            const std::string name = entry.path().filename().string();
+            if (name.size() > prefix.size() && name.compare(0, prefix.size(), prefix) == 0 &&
+                name.size() >= 5 && name.compare(name.size() - 5, 5, ".part") == 0) {
+                std::error_code ec;
+                std::filesystem::remove(entry.path(), ec);
+                SPDLOG_INFO("Removed a leftover archive temporary: {}{}", name,
+                            ec ? " (failed)" : "");
+            }
+        }
+    } catch (const std::exception& e) {
+        SPDLOG_WARN("Could not look for leftover archive temporaries: {}", e.what());
+    }
+
+
     {
         const std::lock_guard<std::mutex> lock(mMutex);
         zip = zip_open(mPath.c_str(), ZIP_CREATE, &openErr);
@@ -66,6 +114,35 @@ int ExporterArchiveO2R::CreateArchive([[maybe_unused]] size_t fileCapacity) {
         return -1;
     }
     mZip = zip;
+
+    /*
+     * Say how the archive write is going, because it is the slowest step and said nothing.
+     *
+     * Extraction reports file N of 547 and finishes in well under a minute. Writing the
+     * archive then takes minutes - a 15MB zip of several thousand entries onto console
+     * storage - and until now reported nothing at all: the dialog sat at "Done. Finishing
+     * up." and the log was silent. That is indistinguishable from a hang, to a player and
+     * to anyone reading a log, and it was taken for one more than once.
+     *
+     * libzip already measures this; it just needs asking. The callback publishes a
+     * fraction that `OTRGlobals` shows on the same progress bar the extraction used, so
+     * the bar keeps moving through the step that takes the longest.
+     */
+    zip_register_progress_callback_with_state(
+        zip, 0.01,
+        [](zip_t*, double progress, void*) {
+            gOtrArchiveProgress = progress;
+            /* Also to the log, at every ten percent: a run captured without a screen is
+             * still worth being able to read. */
+            static int last_tenth = -1;
+            const int tenth = (int)(progress * 10.0);
+            if (tenth != last_tenth) {
+                last_tenth = tenth;
+                SPDLOG_INFO("Writing archive: {:.0f}%", progress * 100.0);
+            }
+        },
+        nullptr, nullptr);
+
     SPDLOG_INFO("Loaded ZIP (O2R) archive: {}", mPath.c_str());
     return 0;
 }

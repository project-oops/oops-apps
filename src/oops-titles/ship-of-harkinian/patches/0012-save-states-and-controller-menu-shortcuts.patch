Save states and controller shortcuts for opening menu and quick saving

Map DualSense shortcuts:
- Touchpad Click, Create, or L3+R3 toggles the Ship of Harkinian menu without
  requiring controller nav to be enabled first.
- L1 + D-Pad Up: Quick Save to current slot
- L1 + D-Pad Down: Quick Load from current slot
- L1 + D-Pad Left/Right: Cycle Save slot (0-5)
- Enable SaveStates and skip long intro cutscene by default on OOPS_TARGET.

diff --git a/soh/soh/Enhancements/bootcommands.c b/soh/soh/Enhancements/bootcommands.c
--- a/soh/soh/Enhancements/bootcommands.c
+++ b/soh/soh/Enhancements/bootcommands.c
@@ -13,5 +13,8 @@ void BootCommands_Init() {
     CVarClear(CVAR_GENERAL("BetterDebugWarpScreenMQModeScene"));
 #if defined(__SWITCH__) || defined(__WIIU__) || defined(OOPS_TARGET)
     CVarRegisterInteger(CVAR_IMGUI_CONTROLLER_NAV, 1); // always enable controller nav on switch/wii u
+    CVarRegisterInteger(CVAR_CHEAT("SaveStatesEnabled"), 1);
+    CVarRegisterInteger(CVAR_CHEAT("SaveStatePromise"), 1);
+    CVarRegisterInteger(CVAR_ENHANCEMENT("TimeSavers.SkipCutscene.Intro"), 1);
 #endif
 }
 

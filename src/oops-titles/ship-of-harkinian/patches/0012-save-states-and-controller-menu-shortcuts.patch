diff --git a/soh/soh/OTRGlobals.cpp b/soh/soh/OTRGlobals.cpp
--- a/soh/soh/OTRGlobals.cpp
+++ b/soh/soh/OTRGlobals.cpp
@@ -1722,5 +1722,59 @@ extern "C" void Graph_StartFrame() {
             break;
         }
     }
+
+    auto gui = Ship::Context::GetInstance()->GetWindow()->GetGui();
+    if (gui && !gui->GetMenuOrMenubarVisible() && CVarGetInteger(CVAR_CHEAT("SaveStatesEnabled"), 0) != 0) {
+        if (ImGui::IsKeyDown(ImGuiKey_GamepadL1)) {
+            auto overlay = gui->GetGameOverlay();
+            if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadUp, false)) {
+                const unsigned int slot = OTRGlobals::Instance->gSaveStateMgr->GetCurrentSlot();
+                const SaveStateReturn ret = OTRGlobals::Instance->gSaveStateMgr->AddRequest({ slot, RequestType::SAVE });
+                if (overlay) {
+                    if (ret == SaveStateReturn::SUCCESS) {
+                        char msg[64];
+                        snprintf(msg, sizeof(msg), "State saved to slot %u", slot);
+                        overlay->TextDrawNotification(3.0f, true, msg);
+                    } else {
+                        overlay->TextDrawNotification(3.0f, true, "Cannot save outside GamePlay");
+                    }
+                }
+            } else if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadDown, false)) {
+                const unsigned int slot = OTRGlobals::Instance->gSaveStateMgr->GetCurrentSlot();
+                const SaveStateReturn ret = OTRGlobals::Instance->gSaveStateMgr->AddRequest({ slot, RequestType::LOAD });
+                if (overlay) {
+                    if (ret == SaveStateReturn::SUCCESS) {
+                        char msg[64];
+                        snprintf(msg, sizeof(msg), "State loaded from slot %u", slot);
+                        overlay->TextDrawNotification(3.0f, true, msg);
+                    } else if (ret == SaveStateReturn::FAIL_STATE_EMPTY) {
+                        char msg[64];
+                        snprintf(msg, sizeof(msg), "State slot %u is empty", slot);
+                        overlay->TextDrawNotification(3.0f, true, msg);
+                    } else {
+                        overlay->TextDrawNotification(3.0f, true, "Cannot load outside GamePlay");
+                    }
+                }
+            } else if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadRight, false)) {
+                unsigned int slot = OTRGlobals::Instance->gSaveStateMgr->GetCurrentSlot();
+                slot = (slot >= 5) ? 0 : slot + 1;
+                OTRGlobals::Instance->gSaveStateMgr->SetCurrentSlot(slot);
+                if (overlay) {
+                    char msg[64];
+                    snprintf(msg, sizeof(msg), "Save state slot: %u", slot);
+                    overlay->TextDrawNotification(3.0f, true, msg);
+                }
+            } else if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadLeft, false)) {
+                unsigned int slot = OTRGlobals::Instance->gSaveStateMgr->GetCurrentSlot();
+                slot = (slot == 0) ? 5 : slot - 1;
+                OTRGlobals::Instance->gSaveStateMgr->SetCurrentSlot(slot);
+                if (overlay) {
+                    char msg[64];
+                    snprintf(msg, sizeof(msg), "Save state slot: %u", slot);
+                    overlay->TextDrawNotification(3.0f, true, msg);
+                }
+            }
+        }
+    }
 #endif
 }


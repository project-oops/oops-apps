# Held out of CI: every upstream source includes a ROM-derived asset, and the two ways to
# have one are a ROM, which no build carries, or `make blank-assets`, which needs python3
# that the check container does not install. Without either, the first actor compiled stops
# on a missing `.inc.c` and takes the whole run with it. Drop this line once the generation
# runs from the build rather than by hand.
CI_SKIP=1

No mmap, regex, scandir or directory descriptors on this target

`utils/config.h` assumes a POSIX system has all four, and upstream already
turns them off where they are absent (Windows, RISC OS, Haiku, AmigaOS, MiNT,
Serenity). This target joins those lists:

- `mmap`: the POSIX layer deliberately declares none - there is no memory
  mapping of files here. The file fetcher reads instead.
- `regex`: there is no regex library. NetSurf's own stand-ins
  (`utils/utils.c`) are what it uses without one; "save complete" loses its
  `@import` rewriting.
- `scandir`: not in the POSIX layer; NetSurf has its own.
- `dirfd`, `fstatat`, `unlinkat` together: a directory stream here has no
  descriptor to hand `fstatat`, so the path-joining fallback is the one that
  works.

diff --git a/netsurf-all-3.11/netsurf/utils/config.h b/netsurf-all-3.11/netsurf/utils/config.h
index f54326d..b7c0f04 100644
--- a/netsurf-all-3.11/netsurf/utils/config.h
+++ b/netsurf-all-3.11/netsurf/utils/config.h
@@ -136,27 +136,27 @@ char *realpath(const char *path, char *resolved_path);
 #endif
 
 #define HAVE_MMAP
-#if (defined(_WIN32) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__))
+#if (defined(_WIN32) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__) || defined(__PROSPERO__))
 #undef HAVE_MMAP
 #endif
 
 #define HAVE_SCANDIR
 #if (defined(_WIN32) ||				\
-     defined(__serenity__))
+     defined(__serenity__) || defined(__PROSPERO__))
 #undef HAVE_SCANDIR
 #endif
 
 #define HAVE_DIRFD
 #define HAVE_UNLINKAT
 #define HAVE_FSTATAT
-#if (defined(_WIN32) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__))
+#if (defined(_WIN32) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__) || defined(__PROSPERO__))
 #undef HAVE_DIRFD
 #undef HAVE_UNLINKAT
 #undef HAVE_FSTATAT
 #endif
 
 #define HAVE_REGEX
-#if (defined(__serenity__))
+#if (defined(__serenity__) || defined(__PROSPERO__))
 #undef HAVE_REGEX
 #endif
 

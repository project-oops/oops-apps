+/*
+===============
+IN_ScreenKeyboard_f
+
+Opens the platform's on-screen keyboard, for a player with only a pad. Text input is
+started once for the whole session (IN_Init), so the keyboard cannot simply follow it;
+this asks for it once, by name, when the menus want text. What the player enters arrives
+as SDL_TEXTINPUT, which reaches the focused field like typed characters.
+===============
+*/
+static void IN_ScreenKeyboard_f( void )
+{
+	SDL_SetHint( SDL_HINT_ENABLE_SCREEN_KEYBOARD, "1" );
+	SDL_StartTextInput( );
+	SDL_SetHint( SDL_HINT_ENABLE_SCREEN_KEYBOARD, "0" );
+}
+
 void IN_Shutdown( void )
 {
+	Cmd_RemoveCommand( "in_screenkeyboard" );
 	SDL_StopTextInput( );
 
 	IN_DeactivateMouse( qtrue );

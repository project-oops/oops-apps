APP_NAME=oopsy-daisy
EXPLICIT_TITLE_ID=1
TITLE_ID=OPSY00001
TITLE_NAME="OOPSy-daisy"
APP_SUBTITLE="Install oops-apps homebrew onto the console, no PC needed"
TITLE_CATEGORY=big-app
KIND=utility
TITLE_VERSION=01.00
# Ships a title so it appears in the index and can be installed - from itself, once the SDK's
# HTTPS + unzip land. Until then the installed title shows its bring-up screen (network support
# pending) rather than actually installing.
FORMATS=elf title

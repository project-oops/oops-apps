diff --git a/src/file/SDL_rwops.c b/src/file/SDL_rwops.c
index 444bf4a..a5c9080 100644
--- a/src/file/SDL_rwops.c
+++ b/src/file/SDL_rwops.c
@@ -36,9 +36,11 @@
 
 #ifdef HAVE_STDIO_H
 #include <stdio.h>
+#ifndef __PROSPERO__
 #include <errno.h>
 #include <sys/stat.h>
 #endif
+#endif
 #ifdef HAVE_LIMITS_H
 #include <limits.h>
 #endif
@@ -533,6 +535,10 @@ static SDL_bool IsRegularFileOrPipe(FILE *f)
         !((st.st_mode & _S_IFMT) == _S_IFREG || (st.st_mode & _S_IFMT) == _S_IFIFO)) {
         return SDL_FALSE;
     }
+    #elif defined(__PROSPERO__)
+    /* No fstat and no pipes. This SDK's fopen opens a file or fails, so a handle in hand is
+       already the answer this check exists to get. */
+    (void)f;
     #else
     struct stat st;
     if (fstat(fileno(f), &st) < 0 || !(S_ISREG(st.st_mode) || S_ISFIFO(st.st_mode))) {
@@ -633,7 +639,12 @@ SDL_RWops *SDL_RWFromFile(const char *file, const char *mode)
         FILE *fp = fopen(file, mode);
 #endif
         if (!fp) {
+#ifdef __PROSPERO__
+            /* No errno here, and "Couldn't open x: Success" is worse than saying less. */
+            SDL_SetError("Couldn't open %s", file);
+#else
             SDL_SetError("Couldn't open %s: %s", file, strerror(errno));
+#endif
         } else if (!IsRegularFileOrPipe(fp)) {
             fclose(fp);
             fp = NULL;

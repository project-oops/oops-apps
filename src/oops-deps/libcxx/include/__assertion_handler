/*
 * libc++ includes <__assertion_handler> from <__assert>, and expects CMake to have generated it.
 * We do not run libc++'s CMake, so this is ours - and it is the whole of what upstream's default
 * does once hardening is off, without dragging in `__verbose_abort`, which wants `fprintf` and
 * `abort` at a point in the header graph where neither is wanted.
 *
 * A trap rather than a message: a hardening assertion firing means a container invariant is
 * already broken, and stopping at the instruction that found it is more use on a console than a
 * line of text nobody is reading.
 */
#ifndef _LIBCPP___ASSERTION_HANDLER
#define _LIBCPP___ASSERTION_HANDLER
#include <__config>
#define _LIBCPP_ASSERTION_HANDLER(message) __builtin_trap()
#endif

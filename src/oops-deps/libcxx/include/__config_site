/*
 * libc++'s site configuration. CMake normally generates this from `__config_site.in`; we do not
 * run libc++'s CMake, so it is written out here - which also means every switch is a decision
 * somebody made rather than whatever the build machine happened to have.
 *
 * The shape is upstream's: `#cmakedefine01` entries become `#define X 0` or `#define X 1`, and
 * `#cmakedefine` entries are either defined or absent.
 */
#ifndef _LIBCPP___CONFIG_SITE
#define _LIBCPP___CONFIG_SITE

#define _LIBCPP_ABI_VERSION 1
#define _LIBCPP_ABI_NAMESPACE __1
#define _LIBCPP_ABI_FORCE_ITANIUM 0
#define _LIBCPP_ABI_FORCE_MICROSOFT 0

/*
 * **Threads, through oops-sdk rather than through pthread** (2026-09-25).
 *
 * This was 0, and the note here said the cost of that being wrong would be visible rather than
 * silent - "a title using `std::thread` or `std::mutex` fails to compile, at the line that wrote
 * it". That is exactly what happened, and the note was right to expect it: `<spdlog/spdlog.h>`
 * gave fifteen errors and eleven were `std::mutex`, `std::thread`, `std::recursive_mutex` and
 * `std::condition_variable`. spdlog is in 123 of Ship of Harkinian's files, so that is not a
 * title that can be asked to avoid them.
 *
 * What the old note got wrong is only which of the three backends to reach for. It listed
 * `pthread_*` symbols as the price, and they are not on offer here - the platform's are
 * `scePthread*` and are reached through `oops/thread.h`. `_LIBCPP_HAS_THREAD_API_EXTERNAL` is the
 * arm for precisely that: libc++ includes `<__external_threading>` and asks for 36 names, and
 * `include/__external_threading` in this directory supplies them from the SDK.
 *
 * Two of the 36 needed the SDK to grow: `oops_mutex_init_recursive`, because libc++ requires
 * `std::recursive_mutex` to be a distinct type from `std::mutex`, and `oops_tls_*`, which every
 * threaded C++ program reaches through `std::thread`'s own bookkeeping. Both are in
 * `oops-sdk/src/thread/thread.c`.
 */
#define _LIBCPP_HAS_THREADS 1
#define _LIBCPP_HAS_THREAD_API_PTHREAD 0
#define _LIBCPP_HAS_THREAD_API_EXTERNAL 1
#define _LIBCPP_HAS_THREAD_API_WIN32 0
#define _LIBCPP_HAS_THREAD_API_C11 0

/* **Required by threads, and libc++ enforces it** - `__config` refuses the combination with
 * "`_LIBCPP_HAS_MONOTONIC_CLOCK` may only be false when `_LIBCPP_HAS_THREADS` is false". That is
 * reasonable: a timed wait needs a clock that does not go backwards. `steady_clock::now()` wants
 * `clock_gettime(CLOCK_MONOTONIC)`, which `common/posix/` now supplies over
 * `oops_time_get_ns` - see the shim, and note that the SDK's counter is monotonic by
 * construction where `CLOCK_REALTIME` is not. */
#define _LIBCPP_HAS_MONOTONIC_CLOCK 1
#define _LIBCPP_HAS_TERMINAL 0
#define _LIBCPP_HAS_MUSL_LIBC 0
#define _LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS 0
/*
 * `_LIBCPP_HAS_FILESYSTEM` gates `<fstream>` as well as `<filesystem>`, and `<fstream>` is the
 * one that is wanted (2026-09-23). `basic_filebuf` is `fopen`/`fread`/`fwrite`/`fseek` and
 * nothing else, all of which oops-sdk has; the directory-walking half of `<filesystem>` is a
 * separate set of library sources that this build does not compile, so turning the macro on
 * makes the streams available without claiming the rest.
 *
 * The CTS writes its result log through one, and `tcu::TestLog` is not optional.
 *
 * **If `<filesystem>` is ever actually included by something, this needs revisiting** - it would
 * then want `dirent.h`, `stat`, symlinks and a working directory, none of which exist here. The
 * link would say so by naming `std::__fs::filesystem::*`, which is the loud failure rather than
 * the quiet one.
 */
#define _LIBCPP_HAS_FILESYSTEM 1
#define _LIBCPP_HAS_RANDOM_DEVICE 0
#define _LIBCPP_HAS_TIME_ZONE_DATABASE 0
#define _LIBCPP_INSTRUMENTED_WITH_ASAN 0
#define _LIBCPP_HAS_NO_STD_MODULES

/*
 * **No wide characters.** This is what collapses the locale surface from unmanageable to
 * absent: `__locale_dir/support/bsd_like.h` guards every `isw*_l`, `wcs*_l` and `mb*_l` wrapper
 * behind this switch, so turning it off removes about thirty of the forty-five platform
 * functions libc++ would otherwise want. Nothing in the queued titles uses `wchar_t`.
 */
#define _LIBCPP_HAS_WIDE_CHARACTERS 0
#define _LIBCPP_HAS_UNICODE 0

/*
 * **No localization, and this is the consequential one.**
 *
 * With it off, libc++ gives `std::string`, the containers, the algorithms and `<charconv>`, and
 * does *not* give `<iostream>`, `<sstream>`, `<fstream>` or `<iomanip>` - formatted stream I/O
 * goes through locale facets, so the two stand or fall together.
 *
 * With it on, `__FreeBSD__` selects `__locale_dir/support/freebsd.h`, which wants `<xlocale.h>`,
 * `newlocale`, a rune table and the `_CTYPE_*` masks, and then `src/locale.cpp` - 5643 lines -
 * has to build on top of all of it. That is a locale implementation we would own, and the whole
 * of what the first C++ title asks of streams is **29 uses across 4 files**: five
 * `ostringstream`, fourteen `istringstream`, one `ofstream`, four `cout` and five `endl`.
 *
 * Measured rather than guessed, and the ratio is what decides it. It is left overridable so the
 * question can be reopened by a title that genuinely needs streams, rather than being settled
 * here for everybody for ever.
 *
 * # Reopened on 2026-09-23, by the title that genuinely needs streams
 *
 * The GL 3.3 CTS. Its framework is an ordinary C++ application: `framework/common` and
 * `framework/opengl` of `opengl-cts-4.6.8.1` include `<sstream>` 15 times, `<ostream>` 6,
 * `<iostream>` 4 and `<fstream>` 4, and `tcu::TestLog` builds every message through a stream.
 * That is not 29 uses in one title, it is the reporting mechanism of the suite that decides
 * whether this collection's OpenGL claim is true. See `oops-apps#D007`.
 *
 * **What it actually cost was far less than the paragraph above feared**, and the fear was
 * reasonable - it assumed implementing FreeBSD's `_l` function family. Instead libc++'s own
 * no-locale backend is selected (`__locale_dir/support/freebsd.h` here shadows upstream's and
 * defers to Fuchsia's), so what remained was: `locale.h`, `nl_types.h` and `runetype.h` in this
 * directory, a generated C-locale character table, and five additions to oops-sdk's C library -
 * `asprintf`/`vasprintf`, `strcoll`/`strxfrm`, the `_CTYPE_*` masks, a `<wchar.h>` that exists
 * to declare `struct tm`, and `ungetc`. 32 of libc++'s 45 sources now compile, up from 25, and
 * every stream source is among them.
 *
 * **This must stay in `__config_site` rather than the library's own build flags.** A title that
 * includes `<sstream>` reads this file too, and if it disagreed with the library about whether
 * localization exists, the two would disagree about the layout of every stream class - which
 * links cleanly and fails at run time.
 */
#ifndef _LIBCPP_HAS_LOCALIZATION
#  define _LIBCPP_HAS_LOCALIZATION 1
#endif

/*
 * The parallel algorithms need a backend named even when nothing is parallel: without one,
 * `__pstl/backend_fwd.h` stops with "Invalid PSTL backend configuration". Serial is the only
 * honest choice with `_LIBCPP_HAS_THREADS 0` - the other two are std::thread and libdispatch.
 */
#define _LIBCPP_PSTL_BACKEND_SERIAL

/* Hardening off: the bounds and precondition checks cost a branch each and their handler is a
   trap. A title wanting them sets `_LIBCPP_HARDENING_MODE` on its own command line. */
#define _LIBCPP_HARDENING_MODE_DEFAULT _LIBCPP_HARDENING_MODE_NONE

#endif /* _LIBCPP___CONFIG_SITE */

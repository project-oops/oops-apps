# Build output. Each app builds into its own build/; nothing under one is tracked.
build/
*.o
*.a
*.elf
*.prx

# Release staging: each app's `dist` target writes the artifacts CI publishes here.
dist/

# A title's upstream source, fetched at the revision its `upstream.lock` names. The lock,
# patches and shim beside it are tracked; the fetched tree is not.
upstream/

# Python is not used here, so there is no bytecode rule; a stray file shows in `git status`.

# Claude Code's per-person overrides.
.claude/settings.local.json

# Editor and OS files.
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
